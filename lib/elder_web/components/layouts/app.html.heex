<header class="px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between border-b border-base-border py-3 text-sm">
    <div class="flex items-center gap-6">
      <a href="/" class="font-semibold text-primary hover:text-secondary">
        Elder
      </a>
      <nav :if={@current_user} class="flex items-center gap-4">
        <.link
          navigate={~p"/dashboard"}
          class="text-secondary hover:text-primary transition-colors"
        >
          Dashboard
        </.link>
        <.link
          navigate={~p"/skills"}
          class="text-secondary hover:text-primary transition-colors"
        >
          Skills
        </.link>
      </nav>
    </div>

    <div :if={@current_user} class="flex items-center gap-4">
      <div class="flex items-center gap-2">
        <img
          :if={@current_user.avatar_url}
          src={@current_user.avatar_url}
          alt=""
          class="h-6 w-6 rounded-full"
          referrerpolicy="no-referrer"
        />
        <span class="text-secondary">
          {@current_user.name || @current_user.email}
        </span>
      </div>

      <.link
        href="/auth/logout"
        method="delete"
        class="text-xs text-muted transition-colors hover:text-secondary"
      >
        Sign out
      </.link>
    </div>
  </div>
</header>

<main class="px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-4xl">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>
