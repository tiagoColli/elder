# Google OAuth (Ueberauth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google LLM API (req_llm — used for Gemini streaming)
GOOGLE_API_KEY=

# ExLLM Gemini API key (migration: same key as GOOGLE_API_KEY)
# During migration, set this to the same value as GOOGLE_API_KEY
GEMINI_API_KEY=

# Override the default LLM model (optional)
# Default: google:gemini-2.5-flash
# LLM_MODEL=anthropic:claude-haiku-4-5

# Database
DB_USER=elder
DB_PASSWORD=elder
DB_NAME=elder_dev
DB_PORT=5432

# Phoenix
PHX_PORT=4000
PHX_HOST=localhost
SECRET_KEY_BASE=

# Asana integration
ASANA_PAT=
ASANA_DEFAULT_PROJECT_GID=
ASANA_DEFAULT_WORKSPACE_GID=
